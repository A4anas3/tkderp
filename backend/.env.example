# Thakurdwara ERP - Backend Environment Configuration

PROJECT_NAME="Thakurdwara ERP - Coaching Institute Management"
API_V1_STR="/api/v1"
# Set ENV=development to enable /docs, /redoc, and /openapi.json
ENV=production

# Database
DATABASE_URL=postgresql+asyncpg://brightloop_user:brightloop_password@localhost:5432/thakurdwara_erp

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
SECRET_KEY=ThakurdwaraErpSuperSecretKeyMustBeVeryStrongAndSecure2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (add production domain here when configured)
BACKEND_CORS_ORIGINS=["http://100.85.230.18:5173"]

# Storage & Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10
